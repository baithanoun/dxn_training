# Copy to keystore.properties (gitignored) and fill with the owner's release keystore.
# Generate once, for example:
#   keytool -genkeypair -v -keystore dxn-release.jks -alias dxn -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the DXNTrainingApp module.
storeFile=dxn-release.jks
storePassword=CHANGE_ME
keyAlias=dxn
keyPassword=CHANGE_ME
