# DXN Training App - Playwright Environment
# Copy to .env and fill in real values. Never commit .env.

# Base URL for the application under test
# Use http://localhost:3000 for local dev, or your real staging URL.
BASE_URL=http://localhost:3000

# API base URL (often same as BASE_URL for Next.js, separate for SPA)
API_BASE_URL=http://localhost:3000

# Test user credentials
TEST_USER_EMAIL=test.distributor@example.com
TEST_USER_PASSWORD=ChangeMe123!
TEST_USER_PHONE=+966500000001
TEST_DXN_ID=DXN-TEST-001

# Admin test credentials
ADMIN_EMAIL=test.admin@example.com
ADMIN_PASSWORD=ChangeMeAdmin123!

# Leader test credentials
LEADER_EMAIL=test.leader@example.com
LEADER_PASSWORD=ChangeMeLeader123!

# API keys / secrets for mocking or API tests (if needed)
# API_KEY=your_key_here

# Feature flags for tests
ENABLE_A11Y_TESTS=true
ENABLE_PERF_TESTS=true
ENABLE_VISUAL_TESTS=false

# Screenshot / video behavior on failure
TRACE_ON_FAILURE=retain-on-failure
VIDEO_ON_FAILURE=retain-on-failure

# CI / parallel settings
CI_WORKERS=4
