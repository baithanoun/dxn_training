# انسخ هذه القيم إلى قسم Variables في لوحة DockHosting (لا ترفع ملف .env).
# استبدل <domain> و<db-*> بقيمك الفعلية قبل الإنشاء.

APP_NAME="DXN Training"
APP_ENV=production
# أنشئ مفتاحاً مرة واحدة عبر: php artisan key:generate --show
# ثم الصق الناتج هنا (base64:...). لا تتركه فارغاً ولا تغيّره بعد النشر.
APP_KEY=
APP_DEBUG=false
APP_URL=https://<domain>

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# قاعدة بيانات MySQL مُدارة من DockHosting (القيم تُحقن تلقائياً عند الربط).
DB_CONNECTION=mysql
DB_HOST=<db-host>
DB_PORT=3306
DB_DATABASE=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

# جلسات لوحة الإدارة في قاعدة البيانات (الجدول أُنشئ بـ migration).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# نفس المصدر: React وAPI على نفس النطاق، لا حاجة إلى CORS متعدد المصادر.
FRONTEND_URL=https://<domain>

# تُستخدم مرة واحدة فقط عند تشغيل AdminSeeder يدوياً، ثم تُحذف من Variables.
ADMIN_EMAIL=admin@dxn.local
ADMIN_PASSWORD=<one-time-password>
